# Copy to .env and fill in. Every setting without a default here is required:
# the app raises on startup rather than falling back to something insecure.
#
#   cp .env.example .env

# Port 5434 matches the host mapping in docker-compose.yml, which avoids
# colliding with a Postgres installed directly on the host. Substitute the
# POSTGRES_USER and POSTGRES_PASSWORD values set in that file.
DATABASE_URL=postgresql://<user>:<password>@localhost:5434/gameshelf

# 6380 likewise matches docker-compose.yml.
REDIS_URL=redis://localhost:6380/0

# Sign JWTs with this. Generate a real one -- never reuse the placeholder:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Free key from https://rawg.io/apidocs
RAWG_API_KEY=

# --- Optional: defaults live in app/core/config.py ---
# ENVIRONMENT=development
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# RAWG_CACHE_TTL_SECONDS=86400
